VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# server-side only (Netlify functions) -- never prefix with VITE_, never
# reaches the browser bundle. Not needed until Phase 3/4 (admin, reports).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# server-side only -- powers "Send now" and the weekly/monthly scheduled
# vendor report emails. SENDGRID_FROM_EMAIL just needs to be a SendGrid
# "verified sender" to start (a Gmail address works fine); switch to a
# real domain address once that domain has SPF/DKIM set up in SendGrid.
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=you@example.com
