VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# server-side only (Netlify functions) -- never prefix with VITE_, never
# reaches the browser bundle. Not needed until Phase 3/4 (admin, reports).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# server-side only -- the business mailbox the site sends from: vendor report
# emails ("Send now" + weekly/monthly) and the Partner / Report-a-Problem
# notifications. Hostinger mailbox; set these in Netlify, never commit them.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASS=your_mailbox_password_here
# optional: defaults to SMTP_USER
# SMTP_FROM=hello@example.com
